# Copie para .env.local e preencha. O .env.local NÃO vai para o git.
# Estas mesmas variáveis precisam existir no projeto da Vercel.

# Webhook de produção do n8n da live (Workflow "Live Tailândia — inscrição").
# Com ele preenchido, o formulário no localhost dispara o workflow de verdade.
WEBHOOK_LIVE_URL=

# Ledger de leads (opcional em dev; sem isso a função só avisa no console)
SUPABASE_LEADS_URL=
SUPABASE_LEADS_KEY=
